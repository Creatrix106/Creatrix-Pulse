
ENVIRONMENT=development            # development | test | production (production: secure cookies, no /docs)
API_PREFIX=/api                    # routes live under this prefix; NEXT_PUBLIC_API_BASE_URL = <origin><prefix>
LOG_LEVEL=INFO
# PUBLIC_API_URL=https://api.example.com/api   

# ---- database (PostgreSQL 18+, psycopg 3 driver)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
POSTGRES_USER=postgres             # used by docker-compose only
POSTGRES_PASSWORD=postgres         # change this outside of local development
POSTGRES_DB=app_db
POSTGRES_VERSION=18                # 19 becomes GA on 2026-11-19

# ---- browser access 
# Origins (scheme://host:port) of the frontend. Must match exactly; "*" is impossible with cookie auth.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false                # true behind HTTPS (default: true in production)
COOKIE_SAMESITE=lax                # lax: frontend and API on the same site; none (+ secure): different sites
# COOKIE_DOMAIN=.example.com       # share the session cookie across subdomains

# ---- limits
MAX_UPLOAD_MB=25                   # keep in sync with MAX_FILE_SIZE_MB in the frontend (src/config/files.ts)
MAX_ACTIVE_DATASETS_PER_USER=3
ALLOW_REGISTRATION=true            # false closes public sign-up
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCK_MINUTES=5

# ---- formatting of server-written insight text 
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_DAYFIRST=true              # how 03/04/2026 is read when a file does not disambiguate (true: 3 April)

# ---- process 
WEB_CONCURRENCY=2                  # uvicorn worker processes (Docker)
# FORWARDED_ALLOW_IPS=10.0.0.5     # reverse proxy address whose X-Forwarded-* headers are trusted
# RUN_MIGRATIONS=false             # Docker: skip `alembic upgrade head` on start (run it as a separate job)
